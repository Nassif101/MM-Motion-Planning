<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description of the mobile manipulator for MoveIt.
  Named states equal qualified_payload.json poses_rad (test_moveit_config.py).
  The disable_collisions block is generated by generate_collision_matrix (10000 trials);
  regenerate it after any URDF collision-geometry change.
-->
<robot name="mobile_manipulator">
  <group name="arm">
    <chain base_link="arm_mount_link" tip_link="tool0"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="0"/>
    <joint name="elbow_joint" value="0"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="0"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="vertical_carry" group="arm">
    <joint name="shoulder_pan_joint" value="1.5707963267948966"/>
    <joint name="shoulder_lift_joint" value="0"/>
    <joint name="elbow_joint" value="0"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="1.5707963267948966"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="level_extension" group="arm">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="1.5707963267948966"/>
    <joint name="elbow_joint" value="0"/>
    <joint name="wrist_1_joint" value="0"/>
    <joint name="wrist_2_joint" value="-1.5707963267948966"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>

  <!-- The base pose comes from TF; MoveIt never plans base motion (Nav2 owns /cmd_vel). -->
  <virtual_joint name="virtual_joint" type="planar" parent_frame="map" child_link="base_footprint"/>

  <!-- generated self-collision matrix -->
  <disable_collisions link1="arm_mount_link" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="arm_mount_link" link2="front_left_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_mount_link" link2="front_right_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_mount_link" link2="rear_left_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_mount_link" link2="rear_right_wheel_link" reason="Never"/>
  <disable_collisions link1="arm_mount_link" link2="shoulder_pan_link" reason="Adjacent"/>
  <disable_collisions link1="arm_mount_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="front_left_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="front_right_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rear_left_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rear_right_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="shoulder_pan_link" reason="Never"/>
  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="front_left_wheel_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="front_right_wheel_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="rear_left_wheel_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="rear_right_wheel_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="shoulder_pan_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="front_left_wheel_link" link2="front_right_wheel_link" reason="Never"/>
  <disable_collisions link1="front_left_wheel_link" link2="rear_left_wheel_link" reason="Never"/>
  <disable_collisions link1="front_left_wheel_link" link2="rear_right_wheel_link" reason="Never"/>
  <disable_collisions link1="front_left_wheel_link" link2="shoulder_pan_link" reason="Never"/>
  <disable_collisions link1="front_left_wheel_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="front_right_wheel_link" link2="rear_left_wheel_link" reason="Never"/>
  <disable_collisions link1="front_right_wheel_link" link2="rear_right_wheel_link" reason="Never"/>
  <disable_collisions link1="front_right_wheel_link" link2="shoulder_pan_link" reason="Never"/>
  <disable_collisions link1="front_right_wheel_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="rear_left_wheel_link" link2="rear_right_wheel_link" reason="Never"/>
  <disable_collisions link1="rear_left_wheel_link" link2="shoulder_pan_link" reason="Never"/>
  <disable_collisions link1="rear_left_wheel_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="rear_right_wheel_link" link2="shoulder_pan_link" reason="Never"/>
  <disable_collisions link1="rear_right_wheel_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="shoulder_pan_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_pan_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="shoulder_pan_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_1_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
</robot>
