<robot name="mobile_manipulator">
  <material name="chassis_blue">
    <color rgba="0.055 0.22 0.42 1" />
  </material>
  <material name="tire_black">
    <color rgba="0.025 0.025 0.03 1" />
  </material>
  <material name="arm_orange">
