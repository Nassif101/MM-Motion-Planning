<?xml version="1.0"?>
<package format="3">
  <name>mobile_manipulator_geometry</name>
  <version>0.1.0</version>
  <description>Robot collision model, ground projection and footprint geometry of the mobile manipulator and its panel (no ROS graph).</description>
  <maintainer email="maintainer@example.com">Motion Planning MA</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>urdf</depend>
  <depend>nlohmann-json-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>
  <test_depend>mobile_manipulator_description</test_depend>
  <test_depend>mobile_manipulator_control</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
