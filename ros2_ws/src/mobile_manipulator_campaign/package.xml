<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_manipulator_campaign</name>
  <version>0.1.0</version>
  <description>Glue between the MuJoCo plant and the framework (B5, F2): adapters, session, campaign runner, demo server, replay.</description>
  <maintainer email="nassif1012@gmail.com">Mohamad</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>mobile_manipulator_plant</depend>
  <depend>mobile_manipulator_mpc</depend>
  <depend>mobile_manipulator_medium</depend>
  <depend>mobile_manipulator_geometry</depend>
  <depend>mobile_manipulator_navigation</depend>
  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>libssl-dev</depend>
  <exec_depend>mobile_manipulator_description</exec_depend>
  <exec_depend>mobile_manipulator_control</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
