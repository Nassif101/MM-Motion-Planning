<?xml version="1.0"?>
<package format="3">
  <name>mobile_manipulator_mpc</name>
  <version>0.1.0</version>
  <description>Local whole-body MPC of the mobile manipulator (B5): CasADi-generated kinematic model, formulation, solver backends and the FollowPath server node.</description>
  <maintainer email="maintainer@example.com">Motion Planning MA</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- scripts/generate_model.py runs at build time; CasADi comes from pip, pinned to 3.8.1 in .devcontainer/Dockerfile. -->
  <buildtool_depend>python3</buildtool_depend>
  <build_depend>urdfdom_py</build_depend>
  <build_depend>mobile_manipulator_description</build_depend>
  <build_depend>mobile_manipulator_control</build_depend>

  <depend>eigen</depend>
  <depend>libfcl-dev</depend>
  <depend>osqp_vendor</depend>
  <depend>urdf</depend>
  <depend>mobile_manipulator_geometry</depend>
  <depend>mobile_manipulator_navigation</depend>
  <depend>mobile_manipulator_interfaces</depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>rosbag2_cpp</depend>
  <depend>control_msgs</depend>
  <!-- the node reads the robot description and the qualified payload at start-up -->
  <exec_depend>mobile_manipulator_description</exec_depend>
  <exec_depend>mobile_manipulator_control</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>tf2_ros_py</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>domain_coordinator</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
