<?xml version="1.0"?>
<package format="3">
  <name>mobile_manipulator_control</name><version>0.1.0</version>
  <description>Finite-actuator Unity simulated hardware for the research arm.</description>
  <maintainer email="maintainers@example.com">Motion Planning Simulation Maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend><depend>pluginlib</depend><depend>rclcpp</depend><depend>rclcpp_lifecycle</depend><depend>sensor_msgs</depend>
  <exec_depend>controller_manager</exec_depend><exec_depend>joint_trajectory_controller</exec_depend><exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>mobile_manipulator_description</exec_depend><exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend><exec_depend>python3-yaml</exec_depend>
  <depend>std_msgs</depend><depend>control_msgs</depend><depend>trajectory_msgs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>controller_manager_msgs</depend><depend>lifecycle_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- Message types the ROS-TCP endpoint forwards without compile-time types (tf2_msgs is a
       build dependency below). -->
  <exec_depend>nav_msgs</exec_depend>
  <depend>nlohmann-json-dev</depend>
  <depend>tf2_msgs</depend><depend>urdf</depend><depend>ament_index_cpp</depend><depend>rclcpp_action</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
