<?xml version="1.0"?>
<package format="3">
  <name>mobile_manipulator_medium</name>
  <version>0.1.0</version>
  <description>Medium-horizon layer above B5 (Phase 5A, F2): piecewise Bezier trajectory over the base pose and the arm joints, optimized by multi-start SCP, and the node that gives B5 its arc-length references.</description>
  <maintainer email="maintainer@example.com">Motion Planning MA</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>hpipm_vendor</depend>
  <depend>osqp_vendor</depend>
  <depend>daqp_vendor</depend>
  <depend>mobile_manipulator_mpc</depend>
  <depend>mobile_manipulator_navigation</depend>
  <depend>mobile_manipulator_geometry</depend>

  <exec_depend>mobile_manipulator_description</exec_depend>
  <exec_depend>mobile_manipulator_control</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
