{
  "name": "MM Motion Planning — portable ROS 2 Jazzy",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "ma-robot-sim",
  "workspaceFolder": "/workspaces/mm-motion-planning",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "shutdownAction": "stopCompose",
  "forwardPorts": [6080, 9090, 10000],
  "portsAttributes": {
    "6080": { "label": "noVNC desktop" },
    "9090": { "label": "rosbridge WebSocket for ROS-MCP" },
    "10000": { "label": "Unity ROS-TCP endpoint" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "twxs.cmake",
        "eamodio.gitlens",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash" }
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.watcherExclude": {
          "**/build/**": true,
          "**/install/**": true,
          "**/log/**": true,
          "**/.git/objects/**": true
        },
        "cmake.configureOnOpen": false,
        "ros.distro": "jazzy"
      }
    }
  },
  "postCreateCommand": "bash -lc 'source /opt/ros/jazzy/setup.bash && vcs import --skip-existing --input ros2_ws/clearpath-runtime.repos ros2_ws/src && sudo apt-get update && rosdep update && rosdep install --from-paths ros2_ws/src/ROS-TCP-Endpoint ros2_ws/src/clearpath_simulator ros2_ws/src/clearpath_common ros2_ws/src/clearpath_config ros2_ws/src/clearpath_msgs ros2_ws/src/mobile_manipulator_description --ignore-src -r -y'",
  "postAttachCommand": "bash -lc 'source /opt/ros/jazzy/setup.bash && printf \"ROS_DISTRO=%s\\nROS_WS=%s\\nARCH=%s\\n\" \"$ROS_DISTRO\" \"$ROS_WS\" \"$(uname -m)\"'"
}
